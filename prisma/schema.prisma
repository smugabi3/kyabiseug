// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  color       String    @default("#B3121A")
  articles    Article[]
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  dek         String
  content     String
  coverImage  String
  videoUrl    String?
  isBreaking  Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  isVideo     Boolean   @default(false)
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  views       Int       @default(0)
  author      String
  location    String?
  tags        String?
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String
  comments    Comment[]
  authorUser  User?     @relation(fields: [authorId], references: [id])
  authorId    String?

  @@index([categoryId])
  @@index([publishedAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@index([articleId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PageView {
  id            String   @id @default(cuid())
  path          String
  country       String?
  countryRegion String?
  city          String?
  // Hostname the visitor arrived from, e.g. "google.com" — null means no referrer
  // (a direct visit or a private/blocked one). See lib/analytics.ts for how
  // `source` groups this into direct / search / social / internal / other.
  referrer      String?
  source        String
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([country])
  @@index([path])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("subscriber")
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  articles      Article[]
  sectionViews  SectionView[]
}

/// Records when a staff member last opened a given admin section, so "new since
/// you last looked" badges can be per-person rather than shared. Kept in its own
/// table (instead of columns on User) so new sections don't need a migration.
model SectionView {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  /// "subscribers" | "enquiries"
  section  String
  lastSeen DateTime @default(now())

  @@unique([userId, section])
  @@index([userId])
}

/// Submissions from the public Contact and Advertise forms. One table with a
/// `kind` discriminator rather than two near-identical ones, since both are
/// "someone wants a reply" and the newsroom reads them in a single list.
model Enquiry {
  id         String   @id @default(cuid())
  /// "contact" | "advertise"
  kind       String
  name       String
  email      String
  phone      String?
  /// Advertise only.
  company    String?
  /// Advertise only: "banner" | "sponsored-article" | "other".
  advertType String?
  /// Advertise only, free text — deliberately not a number, since enquiries
  /// arrive as ranges, currencies, or "negotiable".
  budget     String?
  message    String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([kind])
  @@index([createdAt])
  @@index([email])
}
