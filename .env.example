# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Required ---

# PostgreSQL connection string.
# Vercel injects this automatically when you provision Postgres from the dashboard.
# Locally, `npm run db:local` serves one at the URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kyabiseug?schema=public"

# Signing key for session cookies. REQUIRED in production — the app refuses to
# start without it, because the development fallback is public in this repo.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# --- Optional ---

# One-time super admin bootstrap, read only by `npm run admin:create`.
# Clear ADMIN_PASSWORD once the account exists; set it again only to reset.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Mailchimp newsletter sync. Leave blank to disable — signups are still stored
# locally and visible on the admin Subscribers page either way.
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""
